TELEGRAM_BOT_TOKEN=put-token-here
# Optional: set after /start shows your chat_id to block other users.
TELEGRAM_ALLOWED_CHAT_ID=
# Optional: provider/model, for example omni/cx/gpt-5.5-high or anthropic/claude-sonnet-4-5.
OPENCODE_MODEL=omni/cx/gpt-5.5-high
# Optional: allow OpenCode to auto-approve tool permissions. Set to 1 only on a trusted local machine.
OPENCODE_SKIP_PERMISSIONS=1
# Optional: stop a stuck OpenCode task after this many milliseconds.
TELEGRAM_TASK_TIMEOUT_MS=600000
